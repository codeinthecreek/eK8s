# Variant pods have no egress, and take ingress only on TCP 8080 from
# loadgen's pods in ek8s-system (DESIGN.md sec 11). podSelector {} covers
# every pod in the namespace, not only hasher's.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: variant
  namespace: {{.Namespace}}
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: ek8s-system
      podSelector:
        matchLabels:
          app: loadgen
    ports:
    - protocol: TCP
      port: 8080
