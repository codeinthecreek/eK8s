# loadgen's target: hasher.{{.Namespace}}.svc.cluster.local:8080
# (DESIGN.md sec 10, sec 11).
apiVersion: v1
kind: Service
metadata:
  name: hasher
  namespace: {{.Namespace}}
  labels:
    app: hasher
spec:
  selector:
    app: hasher
  ports:
  - name: http
    protocol: TCP
    port: 8080
    targetPort: http
