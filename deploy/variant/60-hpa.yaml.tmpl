# Pinned at one pod (DESIGN.md sec 11): min = max = 1, so it never scales;
# the object and its 70% target stay for a later unpin. metrics-server is cluster infra (deploy/up.sh).
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: hasher
  namespace: {{.Namespace}}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: hasher
  minReplicas: 1
  maxReplicas: 1
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
